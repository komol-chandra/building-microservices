# Copy to .env  (cp .env.example .env). docker compose reads .env automatically.
COMPOSE_PROJECT_NAME=msstudy

# ---- Postgres (superuser, only used by init.sql / adminer) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- Per-service DB URLs (host = "postgres" = the compose service name) ----
PRODUCT_DATABASE_URL=postgresql://product_svc:product_pw@postgres:5432/product_db
INVENTORY_DATABASE_URL=postgresql://inventory_svc:inventory_pw@postgres:5432/inventory_db
ORDER_DATABASE_URL=postgresql://order_svc:order_pw@postgres:5432/order_db

# ---- RabbitMQ ----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=ecommerce.events

# ---- Ports (host side) ----
ADMINER_PORT=8080
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
GATEWAY_PORT=8081
PRODUCT_PORT=4001
INVENTORY_PORT=4002
ORDER_PORT=4003
CLIENT_PORT=5173

# ---- Internal service URLs (container DNS, used service-to-service) ----
PRODUCT_SERVICE_URL=http://product-service:4001
INVENTORY_SERVICE_URL=http://inventory-service:4002
ORDER_SERVICE_URL=http://order-service:4003

# ---- Gateway auth ----
JWT_SECRET=change-me-dev-only-secret
JWT_EXPIRES_IN=1h

# ---- Order service ----
TAX_RATE=0.05
