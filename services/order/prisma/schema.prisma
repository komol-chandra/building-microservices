// order_db — owned ONLY by order-service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING   // saved, waiting for inventory to reserve stock (Phase 5)
  CONFIRMED
  FAILED
  CANCELLED
}

model Order {
  id            String      @id @default(uuid())
  // Who placed it. Copied from the gateway's x-user-* headers: there is no
  // users table here, and no FK to one (the user lives in another system).
  userId        String
  userName      String
  userEmail     String
  subtotal      Decimal     @db.Decimal(12, 2)
  discount      Decimal     @db.Decimal(12, 2) @default(0)
  tax           Decimal     @db.Decimal(12, 2)
  grandTotal    Decimal     @db.Decimal(12, 2)
  status        OrderStatus @default(PENDING)
  failureReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items LineItem[]

  @@index([userId, createdAt])
}

model LineItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // SNAPSHOT of the product at the moment of purchase. productId is a plain
  // string (product_db is another service's DB); name/sku/price are COPIED so
  // editing or deleting the product later never rewrites order history.
  productId   String
  productName String
  sku         String
  price       Decimal @db.Decimal(10, 2)
  quantity    Int
  total       Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

// Idempotency (Phase 5): RabbitMQ delivers "at least once", so the same
// inventory.* event can arrive twice. Its eventId is inserted in the SAME
// transaction as the order update; a second insert hits the PK → skip.
model ProcessedEvent {
  eventId     String   @id
  processedAt DateTime @default(now())
}

// Transactional OUTBOX (Phase 8). Saving an order and publishing order.placed are
// two different systems (Postgres, RabbitMQ): no single transaction covers both.
// So we DON'T publish in the request. We insert the event into this table in the
// SAME DB transaction as the order (both commit, or neither), and a background
// relay (events/outbox.ts) publishes unpublished rows and stamps publishedAt.
// RabbitMQ down? Rows wait here and go out when it's back. Nothing is lost, and
// an order can never exist without its event.
model OutboxEvent {
  id            String    @id // = the event's eventId (consumers dedupe on it)
  routingKey    String
  payload       Json
  correlationId String?
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([publishedAt, createdAt])
}
